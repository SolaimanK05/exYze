# Copy to .env and adjust. Never commit .env.
# The defaults below work as they are for a local database.

POSTGRES_USER=exyze
POSTGRES_PASSWORD=exyze_dev
POSTGRES_DB=exyze

# Host port for the database. Change it if 5432 is already taken on your machine.
DB_PORT=5432

# Used by the API, the worker, db/migrate.sh and the tests. Keep it in step with the values above.
DATABASE_URL=postgresql://exyze:exyze_dev@localhost:5432/exyze
